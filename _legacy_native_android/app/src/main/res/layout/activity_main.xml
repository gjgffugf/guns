<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#ff5722"
            android:shadowRadius="18"
            android:text="破 绷 战 场"
            android:textColor="#ffffff"
            android:textSize="46sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="34dp"
            android:letterSpacing="0.25"
            android:text="BREAKBIND  BATTLEFIELD"
            android:textColor="#88ffccaa"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSolo"
            android:layout_width="230dp"
            android:layout_height="58dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/btn_mode"
            android:text="单人模式"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textSize="19sp" />

        <Button
            android:id="@+id/btnMulti"
            android:layout_width="230dp"
            android:layout_height="58dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/btn_mode"
            android:text="多人模式"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textSize="19sp" />

        <Button
            android:id="@+id/btnRoom"
            android:layout_width="230dp"
            android:layout_height="58dp"
            android:alpha="0.55"
            android:background="@drawable/btn_mode"
            android:text="开房间"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textSize="19sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/btnSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_margin="14dp"
        android:background="@drawable/btn_round"
        android:gravity="center"
        android:padding="10dp"
        android:text="⚙"
        android:textColor="#ffffff"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tvTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:text="左侧摇杆移动 · 右半屏滑动转视角"
        android:textColor="#66ffffff"
        android:textSize="12sp" />

    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#05080f"
        android:visibility="gone" />

</FrameLayout>
